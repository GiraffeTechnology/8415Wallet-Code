import test from 'node:test';
import assert from 'node:assert/strict';
import {readSnapshot,classifyCode,validateEndpoint,createRpc,GENESIS,WALLETS} from '../scripts/hoodi-readonly-check.mjs';
const hash=`0x${'ab'.repeat(32)}`;
function fixture(changes={}){const calls=[];return{calls,rpc:async(method,params)=>{calls.push({method,params});if(changes[method])return changes[method](params);if(method==='eth_chainId')return '0x88bb0';if(method==='eth_getBlockByNumber')return params[0]==='0x0'?{hash:GENESIS}:{number:'0x100',hash};if(method==='eth_getCode')return '0x';if(method==='eth_getBalance')return '0xde0b6b3a7640000';if(method==='eth_getTransactionCount')return '0x1';throw Error('UNEXPECTED_RPC')}}}
test('snapshot binds both original addresses to one finalized Hoodi block',async()=>{const f=fixture();const r=await readSnapshot(f.rpc);assert.deepEqual(r.accounts.map(x=>x.tenant),['synthetic-alpha','synthetic-beta']);assert.equal(r.accounts[0].balanceWei,'1000000000000000000');assert.equal(r.accounts[0].classification,'no-code-observed');assert.equal(r.ownershipProven,false);assert.equal(r.transactionsSubmitted,false);assert.equal(f.calls.length,10);for(const x of f.calls.filter(x=>['eth_getCode','eth_getBalance','eth_getTransactionCount'].includes(x.method)))assert.equal(x.params[1],'0x100')});
test('wrong network fails before reading any address',async()=>{const f=fixture({eth_chainId:()=> '0xaa36a7'});await assert.rejects(readSnapshot(f.rpc),/HOODI_CHAIN_MISMATCH/);assert.equal(f.calls.length,1)});
test('wrong genesis, missing finality and changed block fail closed',async()=>{for(const behavior of [p=>p[0]==='0x0'?{hash}:{number:'0x100',hash},p=>p[0]==='0x0'?{hash:GENESIS}:null,p=>p[0]==='0x0'?{hash:GENESIS}:p[0]==='finalized'?{number:'0x100',hash}:{number:'0x100',hash:`0x${'cd'.repeat(32)}`}]){await assert.rejects(readSnapshot(fixture({eth_getBlockByNumber:behavior}).rpc),/GENESIS_MISMATCH|FINALIZED_BLOCK_REQUIRED|SNAPSHOT_BLOCK_CHANGED/)}});
test('code is not blindly classified as EOA or contract',()=>{assert.equal(classifyCode('0x').classification,'no-code-observed');assert.equal(classifyCode(`0xef0100${'12'.repeat(20)}`).classification,'eip7702-delegation-observed');assert.equal(classifyCode('0x60006000').classification,'code-present');assert.throws(()=>classifyCode('0x0'),/RPC_HEX_INVALID/)});
test('credential URLs, redirects and unsafe RPC methods are refused',async()=>{for(const url of ['http://rpc.example.invalid','https://u:p@rpc.example.invalid','https://rpc.example.invalid/?token=secret'])assert.throws(()=>validateEndpoint(url),/RPC_HTTPS_NO_CREDENTIAL_URL_REQUIRED/);let called=false;const rpc=createRpc('https://rpc.example.invalid',{fetchImpl:()=>{called=true}});await assert.rejects(rpc('eth_sendTransaction',[]),/READONLY_METHOD_REFUSED/);assert.equal(called,false)});
test('transport errors reveal no endpoint or provider body',async()=>{const rpc=createRpc('https://rpc.example.invalid',{fetchImpl:async()=>({ok:false,status:403})});await assert.rejects(rpc('eth_chainId',[]),/^Error: RPC_HTTP_403$/)});
